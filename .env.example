# Copy to .env (backend reads it from the backend/ working directory or the environment).
# Never commit real secrets.

# --- Database (PostgreSQL 16 + pgvector) ---
DATABASE_URL=postgresql+psycopg://trialmatch@localhost:5433/trialmatch
POSTGRES_PASSWORD=trialmatch-local-only

# --- Anthropic Claude (optional; without it the app shows retrieved studies + rule-based checks only) ---
# ANTHROPIC_AUTH: auto (default) uses ANTHROPIC_API_KEY if set, otherwise an `ant auth login` profile.
# For local development you can skip the key entirely: run `ant auth login` once.
ANTHROPIC_AUTH=auto
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
LLM_MAX_TRIALS_PER_MATCH=8
LLM_CONCURRENCY=4

# --- Embeddings ---
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=pritamdeka/S-PubMedBert-MS-MARCO

# --- ClinicalTrials.gov ---
CTGOV_REQUESTS_PER_MINUTE=40
TRIAL_CACHE_TTL_HOURS=24
SEARCH_CACHE_TTL_HOURS=6
MAX_CANDIDATES=60

# --- Geocoding of the patient's city/postal code only (nominatim | none) ---
GEOCODER=nominatim

# --- Privacy / hardening ---
SESSION_TTL_MINUTES=60
RATE_LIMIT_PER_MINUTE=30
CORS_ORIGINS=["http://localhost:3000","http://localhost:3010"]

# --- Frontend (frontend/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8010
